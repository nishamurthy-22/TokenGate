FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mockbackend ./cmd/mockbackend

FROM alpine:3.20
COPY --from=build /out/mockbackend /mockbackend
EXPOSE 9000
ENTRYPOINT ["/mockbackend"]
